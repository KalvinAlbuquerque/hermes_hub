// Arquivo: backend/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Definimos Profile PRIMEIRO ---
model Profile {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions Json
  createdAt   DateTime @default(now())

  users User[]

  @@map("profiles")
}

// --- Agora definimos User, que referencia Profile ---
model User {
  id        String    @id @default(uuid())
  name      String
  login     String    @unique
  email     String    @unique
  password  String
  mfaSecret String?
  status    String    @default("ENABLED")
  createdAt DateTime  @default(now())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  templates              Template[]
  // Relações renomeadas e adicionadas
  submittedNotifications NotificationLog[] @relation("SubmittedByUser")
  approvedNotifications  NotificationLog[] @relation("ApprovedByUser")
  auditLogs              AuditLog[]        @relation("UserAuditLogs")
  @@map("users")
}

model Cliente {
  id     String   @id @default(uuid())
  name   String   @unique
  emails Json     // Armazena a lista de e-mails em formato JSON
  status String   @default("ACTIVE") // Pode ser ACTIVE ou INACTIVE

  // Relacionamento com os logs de notificação
  notificationLogs NotificationLog[]

  @@map("clientes")
}


model Template {
  id        String   @id @default(uuid())
  name      String
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  notificationLogs NotificationLog[]

  @@map("templates")
}

model EmailAccount {
  id        String    @id @default(uuid())
  name      String    @unique // Ex: "Gmail Pessoal", "E-mail de Suporte"
  email     String
  smtpHost  String
  smtpPort  Int
  smtpUser  String
  smtpPass  String    // Será armazenado encriptado
  smtpSecure Boolean  @default(true)
  status    String    @default("ACTIVE")

  // Relacionamento com os logs para saber quantas vezes foi usada
  notificationLogs NotificationLog[]

  @@map("email_accounts")
}

model SystemSetting {
  id        String    @id @default(uuid())
  key       String    @unique // Ex: "smtpHost", "smtpUser", "smtpPass"
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("system_settings")
}

model NotificationLog {
  id             String    @id @default(uuid())
  // O recipientEmail será movido para um campo JSON para suportar múltiplos destinatários
  recipients     Json      // Armazena a lista de e-mails
  status         String    // PENDING, APPROVED, REJECTED, SENT, FAILED
  sentAt         DateTime? // Opcional, preenchido apenas no envio
  createdAt      DateTime  @default(now())
  rejectionReason  String?
  subject        String    // Assunto final da notificação
  body           String    // Corpo final com variáveis preenchidas
  emailAccountId String?
  emailAccount   EmailAccount? @relation(fields: [emailAccountId], references: [id])
  attachments    Json?     // <-- ADICIONE ESTA LINHA para guardar a lista de anexos
  templateId String
  template   Template @relation(fields: [templateId], references: [id])

  // Analista que submeteu
  submittedByUserId String
  submittedByUser   User   @relation("SubmittedByUser", fields: [submittedByUserId], references: [id])

  // Aprovador (opcional)
  approvedByUserId String?
  approvedByUser   User?   @relation("ApprovedByUser", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  clientes      Cliente[]
  @@map("notification_logs")
}

model AuditLog {
  id          String    @id @default(uuid())
  action      String    // Ex: "USER_LOGIN", "TEMPLATE_CREATE", "NOTIFICATION_APPROVE"
  details     Json?     // Um JSON para guardar detalhes extras, como o nome do template criado
  ipAddress   String?   // Opcional: para registrar o IP de quem fez a ação
  createdAt   DateTime  @default(now())

  // Relacionamento com o usuário que realizou a ação
  userId      String
  user        User      @relation("UserAuditLogs", fields: [userId], references: [id])

  @@map("audit_logs")
}
