// Arquivo: backend/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Definimos Profile PRIMEIRO ---
model Profile {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions Json
  createdAt   DateTime @default(now())

  users User[]

  @@map("profiles")
}

// --- Agora definimos User, que referencia Profile ---
model User {
  id        String    @id @default(uuid())
  name      String
  login     String    @unique
  email     String    @unique
  password  String
  mfaSecret String?
  status    String    @default("ENABLED")
  createdAt DateTime  @default(now())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  templates              Template[]
  // Relações renomeadas e adicionadas
  submittedNotifications NotificationLog[] @relation("SubmittedByUser")
  approvedNotifications  NotificationLog[] @relation("ApprovedByUser")

  @@map("users")
}


model Template {
  id        String   @id @default(uuid())
  name      String
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  notificationLogs NotificationLog[]

  @@map("templates")
}

model NotificationLog {
  id             String    @id @default(uuid())
  // O recipientEmail será movido para um campo JSON para suportar múltiplos destinatários
  recipients     Json      // Armazena a lista de e-mails
  status         String    // PENDING, APPROVED, REJECTED, SENT, FAILED
  sentAt         DateTime? // Opcional, preenchido apenas no envio
  createdAt      DateTime  @default(now())

  subject        String    // Assunto final da notificação
  body           String    // Corpo final com variáveis preenchidas

  templateId String
  template   Template @relation(fields: [templateId], references: [id])

  // Analista que submeteu
  submittedByUserId String
  submittedByUser   User   @relation("SubmittedByUser", fields: [submittedByUserId], references: [id])

  // Aprovador (opcional)
  approvedByUserId String?
  approvedByUser   User?   @relation("ApprovedByUser", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?

  @@map("notification_logs")
}