// Arquivo: backend/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions Json
  createdAt   DateTime @default(now())
  users       User[]
  @@map("profiles")
}

model User {
  id                   String            @id @default(uuid())
  name                 String
  login                String            @unique
  email                String            @unique
  password             String
  mfaSecret            String?
  status               String            @default("ENABLED")
  createdAt            DateTime          @default(now())
  profileId            String
  profile              Profile           @relation(fields: [profileId], references: [id], onDelete: Restrict)
  templates            Template[]
  submittedNotifications NotificationLog[] @relation("SubmittedByUser")
  approvedNotifications  NotificationLog[] @relation("ApprovedByUser")
  auditLogs            AuditLog[]        @relation("UserAuditLogs")
  @@map("users")
}

model Cliente {
  id               String            @id @default(uuid())
  name             String            @unique
  emails           Json
  status           String            @default("ACTIVE")
  notificationLogs NotificationLog[]
  @@map("clientes")
}

model Template {
  id               String            @id @default(uuid())
  name             String
  subject          String
  body             String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  authorId         String?
  author           User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  notificationLogs NotificationLog[]
  categoryId       String?
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@map("templates")
}

model EmailAccount {
  id               String            @id @default(uuid())
  name             String            @unique
  signature        String?           @db.Text
  email            String
  
  // --- Campos Legados ---
  smtpHost         String? // Agora opcional
  smtpPort         Int?    // Agora opcional
  smtpUser         String? // Agora opcional
  smtpPass         String? // Agora opcional
  smtpSecure       Boolean?          @default(true)

  // --- Novos Campos para OAuth2 ---
  authType         String            @default("PASSWORD") // PASSWORD ou OAUTH2
  accessToken      String?
  refreshToken     String?
  tokenExpiresAt   DateTime?

  status           String            @default("ACTIVE")
  notificationLogs NotificationLog[]
  @@map("email_accounts")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("system_settings")
}

model NotificationLog {
  id                   String        @id @default(uuid())
  recipients           Json
  senderHasReadReply   Boolean       @default(false)
  status               String
  sentAt               DateTime?
  createdAt            DateTime      @default(now())
  rejectionReason      String?
  subject              String
  body                 String
  emailAccountId       String?
  repliedAt            DateTime?
  emailAccount         EmailAccount? @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)
  attachments          Json?
  templateId           String?
  template             Template?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  incidentStatus       String        @default("OPEN")
  submittedByUserId    String?
  submittedByUser      User?         @relation("SubmittedByUser", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId     String?
  approvedByUser       User?         @relation("ApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  clientes             Cliente[]
  nextReminderAt       DateTime?
  protocol             String?       @unique
  replyStatus          String?
  reminders            ReminderLog[]
  messageId            String?
  @@map("notification_logs")
}

model Category {
  id                    String     @id @default(uuid())
  name                  String     @unique
  reminderMode          String
  reminderIntervalHours Int?
  reminderSpecificTime  String?
  reminderTemplateBody  String     @db.Text
  templates             Template[]
  reminderSubject       String
  @@map("categories")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  @@map("audit_logs")
}

model ReminderLog {
  id                String          @id @default(uuid())
  sentAt            DateTime        @default(now())
  notificationLogId String
  notificationLog   NotificationLog @relation(fields: [notificationLogId], references: [id], onDelete: Cascade)
  @@map("reminder_logs")
}