// Arquivo: backend/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions Json
  createdAt   DateTime @default(now())
  users       User[]
  @@map("profiles")
}

model User {
  id                   String            @id @default(uuid())
  name                 String
  login                String            @unique
  email                String            @unique
  password             String
  mfaSecret            String?
  status               String            @default("ENABLED")
  createdAt            DateTime          @default(now())
  profileId            String
  profile              Profile           @relation(fields: [profileId], references: [id])
  templates            Template[]
  submittedNotifications NotificationLog[] @relation("SubmittedByUser")
  approvedNotifications  NotificationLog[] @relation("ApprovedByUser")
  auditLogs            AuditLog[]        @relation("UserAuditLogs")
  @@map("users")
}

model Cliente {
  id               String            @id @default(uuid())
  name             String            @unique
  emails           Json
  status           String            @default("ACTIVE")
  notificationLogs NotificationLog[]
  @@map("clientes")
}

model Template {
  id               String            @id @default(uuid())
  name             String
  subject          String
  body             String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  authorId         String
  author           User              @relation(fields: [authorId], references: [id])
  notificationLogs NotificationLog[]

  categoryId       String?
  category         Category?         @relation(fields: [categoryId], references: [id])

  @@map("templates")
}

model EmailAccount {
  id               String            @id @default(uuid())
  name             String            @unique
  email            String
  smtpHost         String
  smtpPort         Int
  smtpUser         String
  smtpPass         String
  smtpSecure       Boolean           @default(true)
  status           String            @default("ACTIVE")
  notificationLogs NotificationLog[]
  @@map("email_accounts")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("system_settings")
}

model NotificationLog {
  id                String        @id @default(uuid())
  recipients        Json
  status            String
  sentAt            DateTime?
  createdAt         DateTime      @default(now())
  rejectionReason   String?
  subject           String
  body              String
  emailAccountId    String?
  emailAccount      EmailAccount? @relation(fields: [emailAccountId], references: [id])
  attachments       Json?
  templateId        String
  template          Template      @relation(fields: [templateId], references: [id])
  incidentStatus    String        @default("OPEN")
  submittedByUserId String
  submittedByUser   User          @relation("SubmittedByUser", fields: [submittedByUserId], references: [id])
  approvedByUserId  String?
  approvedByUser    User?         @relation("ApprovedByUser", fields: [approvedByUserId], references: [id])
  approvedAt        DateTime?
  clientes          Cliente[]
  nextReminderAt    DateTime?     // Armazena a data/hora exata do próximo lembrete
  protocol          String?       @unique // Adicionamos como opcional e único
  // LINHA ADICIONADA PARA CORRIGIR O ERRO
  reminders         ReminderLog[]

  @@map("notification_logs")
}

model Category {
  id                    String   @id @default(uuid())
  name                  String   @unique
  reminderMode          String   // 'INTERVAL' ou 'SPECIFIC_TIME'
  reminderIntervalHours Int?     // Ex: 4 (para a cada 4 horas)
  reminderSpecificTime  String?  // Ex: "09:00"
  reminderTemplateBody  String   @db.Text // Corpo do e-mail do lembrete
  templates             Template[]
  reminderSubject       String   // Assunto do e-mail de lembrete
  @@map("categories")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation("UserAuditLogs", fields: [userId], references: [id])
  @@map("audit_logs")
}

model ReminderLog {
  id                String    @id @default(uuid())
  sentAt            DateTime  @default(now())
  notificationLogId String
  notificationLog   NotificationLog @relation(fields: [notificationLogId], references: [id], onDelete: Cascade)

  @@map("reminder_logs")
}