# ==============================
# DEPENDÊNCIAS
# ==============================
# Ignora a pasta de dependências do Node.js
node_modules/

# Ignora os arquivos de bloqueio de dependências, já que são gerados a partir do package.json
# Removendo estes do Git, você garante um histórico de versão mais limpo.
package-lock.json
yarn.lock
pnpm-lock.yaml

# ==============================
# ARTEFATOS DE BUILD E SAÍDA
# ==============================
# Next.js
.next/
out/
.vercel/

# Criação de build genérica
dist/
build/
coverage/

# ==============================
# VARIÁVEIS DE AMBIENTE
# ==============================
# Mantenha os segredos e configurações locais fora do controle de versão
.env
.env.local
.env.development.local
.env.production.local

# ==============================
# ARQUIVOS GERADOS AUTOMATICAMENTE
# ==============================
# Logs de debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Arquivos de tipagem e build do TypeScript
*.tsbuildinfo
next-env.d.ts

# Arquivos gerados pelo Prisma
/src/generated/prisma
/prisma/migrations/

# Arquivos de cache e temporários
.cache/
*.tmp
*.swp

# ==============================
# DYNAMIC CONTENT (upload de usuários)
# ==============================
# Ignora arquivos dinâmicos enviados por usuários. Mantenha os seus arquivos de seeds ou estáticos.
backend/public/attachments/*
backend/public/uploads/*
!backend/public/attachments/.gitkeep
!backend/public/uploads/.gitkeep

# ==============================
# IDEs E SISTEMAS OPERACIONAIS
# ==============================
# macOS
.DS_Store

# Visual Studio Code
.vscode/

# JetBrains IDEs (IntelliJ, WebStorm, etc.)
.idea/

# Outros
Thumbs.db